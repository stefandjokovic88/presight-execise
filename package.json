{
  "name": "presight-execise",
  "version": "1.0.0",
  "repository": "",
  "author": "",
  "license": "MIT",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "start": "lerna run start --parallel",
    "start:java": "yarn start:client & yarn start:server:java & wait",
    "seed": "yarn workspace presight-server seed",
    "seed:java": "cd server-java && ./mvnw -q exec:java -Dexec.mainClass=com.presight.users.SeedCli",
    "start:server": "yarn workspace presight-server start",
    "start:server:java": "cd server-java && ./mvnw spring-boot:run",
    "start:client": "yarn workspace presight-client start",
    "build": "yarn workspace presight-client build && yarn workspace presight-server build",
    "build:java": "cd server-java && ./mvnw -DskipTests package",
    "docker:up": "docker compose --profile node up --build",
    "docker:up:java": "docker compose --profile java up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "lerna": "~8.2.1"
  }
}
